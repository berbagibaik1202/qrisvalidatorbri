{
  "name": "rizpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,dashboard,pos,worker \"tsx watch apps/api/src/index.ts\" \"vite --config apps/dashboard/vite.config.ts\" \"tsx watch apps/mini-pos/index.ts\" \"tsx watch apps/worker/src/index.ts\"",
    "pos": "tsx apps/mini-pos/index.ts",
    "start": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:local": "node scripts/local-db.mjs",
    "setup": "npm run db:local && tsx packages/database/seed.ts",
    "seed": "tsx packages/database/seed.ts",
    "build": "tsc --noEmit && vite build --config apps/dashboard/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e.ts",
    "test:mysql": "tsx tests/mysql.ts",
    "test:browser": "playwright test",
    "bri:worker": "tsx apps/worker/src/bri.ts",
    "test:bri": "tsx tests/bri-browser.ts",
    "test:bri:login": "tsx tests/bri-login.ts",
    "test:bri:network": "tsx tests/bri-network.ts",
    "test:bri:portal": "tsx tests/bri-portal.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
